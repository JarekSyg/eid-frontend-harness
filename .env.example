# Copy to .env.local and fill in. Never commit real credentials.

# ── Server-side (never exposed to the browser) ──────────────────────────
# Authologic API base URL and credentials — see https://developer.authologic.com
AUTHOLOGIC_API_URL=
AUTHOLOGIC_API_LOGIN=
AUTHOLOGIC_API_KEY=

# Public HTTPS origin of this app. Authologic rejects localhost callback URLs
# and must be able to reach ${APP_BASE_URL}/api/webhook, so use a tunnel
# (e.g. ngrok) for local dev. Defaults to the request origin when empty.
APP_BASE_URL=

# Shared secret appended to the webhook URL (?token=...). Required in
# production builds: without it, the webhook rejects every request.
WEBHOOK_SECRET=

# ── Client-side (inlined into the browser bundle at build time) ─────────
# Widget id from Authologic. "development_only" works in sandbox.
NEXT_PUBLIC_AUTHOLOGIC_WIDGET_ID=development_only
# "sandbox", "production", or a custom base URL. Must be the same Authologic
# environment as AUTHOLOGIC_API_URL, or the widget can't find the conversation.
NEXT_PUBLIC_AUTHOLOGIC_ENVIRONMENT=sandbox

# Optional: where "Fill out the form" sends the user
NEXT_PUBLIC_FORM_URL=

# Optional: link to this app's source code, shown in the footer (AGPL-3.0
# section 13). Set it to your fork if you deploy a modified version.
NEXT_PUBLIC_SOURCE_URL=
